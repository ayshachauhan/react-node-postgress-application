{
  "name": "@azentia/monorepo",
  "version": "0.0.1",
  "description": "Monorepo for surgery app",
  "repository": "https://github.com/anakshiant-thinksys/azentia",
  "packageManager": "pnpm@8.10.5",
  "private": true,
  "scripts": {
    "turbo": "./node_modules/turbo/bin/turbo",
    "start:dev": "dotenv -e .env -- pnpm turbo start:dev",
    "start:prod": "dotenv -e .env -- pnpm turbo start:prod",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "clean": "turbo clean",
    "prepare": "husky",
    "commit": "git-cz",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@types/node": "^20.10.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.42.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "tslib": "2.3.1",
    "turbo": "^1.10.16"
  },
  "lint-staged": {
    "*": [
      "prettier --write",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
