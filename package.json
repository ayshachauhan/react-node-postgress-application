{
  "name": "@azentia/monorepo",
  "version": "0.0.1",
  "description": "Monorepo for surgery app",
  "repository": "https://github.com/anakshiant-thinksys/azentia",
  "packageManager": "pnpm@8.15.3",
  "private": true,
  "scripts": {
    "turbo": "node ./node_modules/turbo/bin/turbo",
    "start:dev": "dotenv -e .env -- pnpm turbo start:dev",
    "start:prod": "dotenv -e .env -- pnpm turbo start:prod",
    "build": "dotenv -e .env -- pnpm turbo build",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "clean": "turbo clean",
    "prepare": "npx husky install",
    "commit": "git-cz",
    "lint-staged": "lint-staged",
    "migrate": "dotenv -e .env -- pnpm turbo run run-migrations",
    "list-migrations": "dotenv -e .env -- pnpm turbo run list-migrations"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.10.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.42.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2",
    "prettier": "^3.0.0",
    "prettier-plugin-organize-imports": "^3.2.4",
    "ts-node": "^10.9.1",
    "tslib": "2.3.1",
    "turbo": "^1.10.16"
  },
  "lint-staged": {
    "*": [
      "prettier --write",
      "git add"
    ]
  },
  "engines": {
    "pnpm": "8.15.3"
  },
  "dependencies": {
    "js-cookie": "^3.0.5"
  }
}
